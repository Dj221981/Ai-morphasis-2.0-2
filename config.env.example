# Runtime and environment
APP_ENV=development
LOG_LEVEL=info
TIMEZONE=UTC

# Core orchestration
ARMY_ENABLED=true
ARMY_MODE=observe_only
MAX_PARALLEL_TASKS=200
HUMAN_APPROVAL_REQUIRED=true

# Approval and notifications
APPROVAL_CHANNEL=security-ops
APPROVAL_TIMEOUT_SECONDS=300
ALERT_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Telemetry ingestion (SIEM/EDR/Identity/Cloud)
SIEM_PROVIDER=
SIEM_API_URL=
SIEM_API_KEY=

EDR_PROVIDER=
EDR_API_URL=
EDR_API_KEY=

IDENTITY_PROVIDER=
IDENTITY_API_URL=
IDENTITY_API_KEY=

CLOUD_PROVIDER=
CLOUD_API_URL=
CLOUD_API_KEY=

# Threat intelligence
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_URL=
THREAT_INTEL_API_KEY=
THREAT_INTEL_POLL_INTERVAL_SECONDS=300

# Storage and queues
EVENT_QUEUE_URL=
EVENT_QUEUE_NAME=security-events
STATE_STORE_URL=
ARTIFACT_STORE_URL=

# Optional integrations
TICKET_SYSTEM_PROVIDER=
TICKET_SYSTEM_API_URL=
TICKET_SYSTEM_API_KEY=

CHATOPS_PROVIDER=
CHATOPS_WEBHOOK_URL=

# Security and compliance
DATA_RETENTION_DAYS=90
PII_REDACTION_ENABLED=true
AUDIT_LOG_IMMUTABLE=true
ENCRYPTION_AT_REST=true
ENCRYPTION_IN_TRANSIT=true

# Defensive policy toggles
ALLOW_DEFENSIVE_RECOMMENDATIONS=true
ALLOW_AUTO_CONTAINMENT=false
BLOCK_OFFENSIVE_TASKS=true

# KPI collection
KPI_COLLECTION_ENABLED=true
KPI_EXPORT_INTERVAL_SECONDS=60
